#!/bin/bash

APP_NAME="memory-assistant"
INSTALL_DIR="$HOME/.local/share/plco-memory-assistant"
APP_PATH="$INSTALL_DIR/bin/$APP_NAME"

# ── Utilities ──────────────────────────────────────────

get_threshold() {
    if [ -f "$APP_PATH" ]; then
        grep -oP '(?<=^THRESHOLD_NOTIFY=)[0-9]+' "$APP_PATH"
    else
        echo "N/A"
    fi
}

get_threshold_alert() {
    if [ -f "$APP_PATH" ]; then
        grep -oP '(?<=^THRESHOLD_ALERT=)[0-9]+' "$APP_PATH"
    else
        echo "N/A"
    fi
}

get_mem_usage() {
    total=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
    available=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)

    if [[ $total -gt 0 ]]; then
        echo $(( (total - available) * 100 / total ))
    else
        echo 0
    fi
}

find_icon() {
    local name="$1" icon_name dir desktop_file
    local -a search_dirs=(
        /usr/share/icons/hicolor/48x48/apps
        /usr/share/icons/hicolor/64x64/apps
        /usr/share/pixmaps
        /var/lib/snapd/desktop/icons
        "$HOME/.local/share/flatpak/exports/share/icons/hicolor/48x48/apps"
    )

    for dir in "${search_dirs[@]}"; do
        [ -f "$dir/$name" ]     && { echo "$dir/$name";     return; }
        [ -f "$dir/$name.png" ] && { echo "$dir/$name.png"; return; }
        [ -f "$dir/$name.svg" ] && { echo "$dir/$name.svg"; return; }
    done

    local lower="${name,,}"
    if [ "$lower" != "$name" ]; then
        for dir in "${search_dirs[@]}"; do
            [ -f "$dir/$lower" ]     && { echo "$dir/$lower";     return; }
            [ -f "$dir/$lower.png" ] && { echo "$dir/$lower.png"; return; }
            [ -f "$dir/$lower.svg" ] && { echo "$dir/$lower.svg"; return; }
        done
    fi

    for pattern in \
        "/usr/share/applications/${name}.desktop" \
        "/usr/share/applications/${name}-browser.desktop" \
        "/var/lib/flatpak/exports/share/applications/${name}.desktop" \
        "$HOME/.local/share/flatpak/exports/share/applications/${name}.desktop"; do
        for desktop_file in $pattern; do
            [ -f "$desktop_file" ] || continue
            icon_name=$(grep -oP '(?<=^Icon=).*' "$desktop_file" | head -1)
            [ -n "$icon_name" ] && break 2
        done
    done

    if [ -n "$icon_name" ]; then
        for dir in "${search_dirs[@]}"; do
            [ -f "$dir/$icon_name" ]     && { echo "$dir/$icon_name";     return; }
            [ -f "$dir/$icon_name.png" ] && { echo "$dir/$icon_name.png"; return; }
            [ -f "$dir/$icon_name.svg" ] && { echo "$dir/$icon_name.svg"; return; }
        done
    fi

    echo ""
}
DEFAULT_ICON=""
for _ic in \
    "/usr/share/icons/hicolor/48x48/apps/fedora-logo-icon.png" \
    "/usr/share/pixmaps/fedora-logo-icon.png"; do
    [ -f "$_ic" ] && { DEFAULT_ICON="$_ic"; break; }
done
[ -z "$DEFAULT_ICON" ] && DEFAULT_ICON=$(find /usr/share/icons -path "*/48x48/*" -name "*.png" 2>/dev/null | head -1)

get_procs() {
    ps -eo comm,rss,etime --sort=-rss | tail -n +2 | head -n 25 | while IFS=' ' read -r comm rss etime; do
        local icon mem_str
        icon=$(find_icon "$comm")
        [ -z "$icon" ] && icon="$DEFAULT_ICON"
        gb=$(awk "BEGIN { printf \"%.2f\", $rss / 1024 / 1024 }")
        if [ "${gb%%.*}" -ge 1 ] 2>/dev/null; then
            mem_str="${gb} GB"
        else
            mem_mb=$(( rss / 1024 ))
            mem_str="${mem_mb} MB"
        fi
        echo "$icon"
        echo "$comm"
        echo "$mem_str"
        echo "$etime"
    done
}

is_running() {
    pgrep -f "$APP_PATH" > /dev/null 2>&1
}

get_pid() {
    pgrep -f "$APP_PATH"
}

get_uptime() {
    local pid
    pid=$(get_pid)
    if [ -n "$pid" ]; then
        ps -o etime= -p "$pid" | xargs
    fi
}

# ── Actions ────────────────────────────────────────────

start_daemon() {
    if is_running; then
        echo "Already running (PID: $(get_pid))."
        return
    fi
    nohup "$APP_PATH" >/dev/null 2>&1 &
    sleep 1
    if is_running; then
        echo "Started successfully (PID: $(get_pid))."
    else
        echo "Failed to start. Check your setup."
    fi
}

stop_daemon() {
    if ! is_running; then
        echo "Not running."
        return
    fi
    pkill -f "$APP_PATH" 2>/dev/null || true
    sleep 0.5
    if is_running; then
        echo "Failed to stop. Try manually."
    else
        echo "Stopped."
    fi
}

restart_daemon() {
    stop_daemon
    start_daemon
}

# ── Screens ────────────────────────────────────────────

show_alert() {
    LOCK_FILE="/tmp/plco-memory-assistant-alert.lock"
    if [ -f "$LOCK_FILE" ] && kill -0 "$(cat "$LOCK_FILE")" 2>/dev/null; then
        echo "Alert window already open."
        return
    fi
    echo $$ > "$LOCK_FILE"

    local threshold_alert
    threshold_alert=$(get_threshold_alert)
    procs=$(get_procs)

    choice=$(echo "$procs" | zenity --list \
        --title="Memory Alert (Threshold: ${threshold_alert}%)" \
        --text="This is a preview of the critical alert window.\n" \
        --imagelist --column="Icon" --column="Application" --column="Memory" --column="Uptime" \
        --print-column=2 \
        --width=900 --height=600 \
        --ok-label="Force Quit" \
        --cancel-label="Close" \
        --icon=dialog-warning)

    if [ -n "$choice" ]; then
        app=$(echo "$choice" | awk '{print $1}')

        LOG=""
        log() { LOG+="$1\n"; }

        log "═══════════════════════════════════════════"
        log " Force Quit"
        log " Target: $app"
        log "═══════════════════════════════════════════"

        zenity --progress --pulsate --no-cancel \
            --text="Force quitting $app..." \
            --title="Processing" --width=350 &
        LOADING_PID=$!

        KILLED=0

        log ""
        log " [1/3] pkill -9 -x \"$app\""
        if pkill -9 -x "$app" 2>/dev/null; then
            log " -> OK"
            KILLED=1
        else
            log " -> no process matched (exit 1)"
            log ""
            log " [2/3] pkill -9 \"$app\""
            if pkill -9 "$app" 2>/dev/null; then
                log " -> OK"
                KILLED=1
            else
                log " -> no process matched (exit 1)"
                log ""
                log " [3/3] pkill -9 -f \"$app\""
                if pkill -9 -f "$app" 2>/dev/null; then
                    log " -> OK"
                    KILLED=1
                else
                    log " -> no process matched (exit 1)"
                fi
            fi
        fi

        kill "$LOADING_PID" 2>/dev/null
        wait "$LOADING_PID" 2>/dev/null

        log ""
        if [ "$KILLED" -eq 1 ]; then
            log " ✅ $app sent SIGKILL"
        else
            log " ⚠️ Could not kill $app"
        fi
        log "═══════════════════════════════════════════"

        echo -e "$LOG" | zenity --text-info \
            --title="Force Quit Result" \
            --width=500 --height=300 \
            --font="monospace"
    fi
    rm -f "$LOCK_FILE"
}

show_top() {
    clear
    printf "  %-22s %-10s %s\n" "COMMAND" "MEMORY" "UPTIME"
    printf "  %s\n" "──────────────────────────────────────────────"
    local line=0 name mem
    while IFS= read -r val; do
        case $((line % 4)) in
            0) ;;                          # icon - skip
            1) name="$val" ;;               # name
            2) mem="$val" ;;                # memory
            3) printf "  %-22s %-10s %s\n" "$name" "$mem" "$val" ;;
        esac
        line=$((line + 1))
    done < <(get_procs)
    echo ""
    read -p "Press Enter to return..."
}

show_status_text() {
    local mem_usage threshold threshold_alert
    mem_usage=$(get_mem_usage)
    threshold=$(get_threshold)
    threshold_alert=$(get_threshold_alert)

    if is_running; then
        echo "  Service:   Running"
        echo "  PID:       $(get_pid)"
        echo "  Uptime:    $(get_uptime)"
        echo "  Memory:    ${mem_usage}%"
        echo "  Notify:    >= ${threshold}%"
        echo "  Alert:     >= ${threshold_alert}%"
    else
        echo "  Service:   Not running"
        echo "  Memory:    ${mem_usage}%"
        echo "  Notify:    >= ${threshold}%"
        echo "  Alert:     >= ${threshold_alert}%"
    fi
}

# ── TUI Menu ───────────────────────────────────────────

show_menu() {
    while true; do
        clear

        local mem_usage threshold threshold_alert running_status pid uptime
        mem_usage=$(get_mem_usage)
        threshold=$(get_threshold)
        threshold_alert=$(get_threshold_alert)

        if is_running; then
            running_status="Running  "
            pid="$(get_pid)"
            uptime="$(get_uptime)"
        else
            running_status="Stopped  "
            pid="--"
            uptime="--"
        fi

        echo "╔══════════════════════════════════════════╗"
        echo "║        PLCO Memory Assistant             ║"
        echo "╠══════════════════════════════════════════╣"
        printf "║  Status:   %s  PID: %-5s     ║\n" "$running_status" "$pid"
        printf "║  Uptime:   %-28s ║\n" "$uptime"
        echo "║                                          ║"
        printf "║  Memory:   %-3s%%                          ║\n" "$mem_usage"
        printf "║  Notify:   >= %-3s%%                         ║\n" "$threshold"
        printf "║  Alert:    >= %-3s%%                         ║\n" "$threshold_alert"
        echo "╚══════════════════════════════════════════╝"
        echo ""
        echo "  1) Start daemon"
        echo "  2) Stop  daemon"
        echo "  3) Restart daemon"
        echo "  4) Test alert (zenity preview)"
        echo "  5) View top processes"
        echo "  6) Exit"
        echo ""
        read -p "  Choose [1-6]: " choice

        case "$choice" in
            1) clear; start_daemon; read -p "Press Enter...";;
            2) clear; stop_daemon;  read -p "Press Enter...";;
            3) clear; restart_daemon; read -p "Press Enter...";;
            4) clear; show_alert;   read -p "Press Enter...";;
            5) show_top;;
            6) clear; exit 0;;
            *) ;;
        esac
    done
}

show_help() {
    cat <<EOF
Usage: $(basename "$0") [option]

Options:
  (no args)  Open interactive TUI
  --alert    Show the alert window (preview)
  --help     Show this help

EOF
}

# ── Entrypoint ─────────────────────────────────────────

case "${1:-}" in
    --alert) show_alert;;
    --help)  show_help;;
    "")
        if [ -t 0 ]; then
            show_menu
        else
            show_status_text
        fi
        ;;
    *)
        echo "Unknown option: $1"
        show_help
        exit 1
        ;;
esac
