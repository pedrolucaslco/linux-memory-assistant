#!/bin/bash

THRESHOLD=80

get_mem_usage() {
  total=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
  available=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)

  if [[ $total -gt 0 ]]; then
    echo $(( (total - available) * 100 / total ))
  else
    echo 0
  fi
}

show_alert() {
  used_percent="$1"

  procs=$(ps -eo comm,rss --sort=-rss | tail -n +2 | head -n 20 | awk '{
    mem_kb=$2
    mem_gb=mem_kb/1024/1024
    if(mem_gb>=1){
      printf "%s\n%.2f GB\n", $1, mem_gb
    } else {
      mem_mb=mem_kb/1024
      printf "%s\n%.0f MB\n", $1, mem_mb
    }
  }')

  choice=$(echo "$procs" | zenity --list \
    --title="⚠️ Your system has run out of application memory." \
    --text="To avoid problems with your computer, quit any applications you are not using. \n" \
    --column="Application" --column="Memory" \
    --width=800 --height=600 \
    --ok-label="Force Quit" \
    --cancel-label="Cancel" \
    --icon=dialog-warning)

  if [ -n "$choice" ]; then
    app=$(echo "$choice" | awk '{print $1}')

    LOG=""
    log() { LOG+="$1\n"; }

    log "═══════════════════════════════════════════"
    log " Force Quit"
    log " Target: $app"
    log "═══════════════════════════════════════════"

    # loading window
    zenity --progress --pulsate --no-cancel \
        --text="Force quitting $app..." \
        --title="Processing" --width=350 &
    LOADING_PID=$!

    KILLED=0

    log ""
    log " [1/3] pkill -9 -x \"$app\""
    if pkill -9 -x "$app" 2>/dev/null; then
      log " -> OK"
      KILLED=1
    else
      log " -> no process matched (exit 1)"
      log ""
      log " [2/3] pkill -9 \"$app\""
      if pkill -9 "$app" 2>/dev/null; then
        log " -> OK"
        KILLED=1
      else
        log " -> no process matched (exit 1)"
        log ""
        log " [3/3] pkill -9 -f \"$app\""
        if pkill -9 -f "$app" 2>/dev/null; then
          log " -> OK"
          KILLED=1
        else
          log " -> no process matched (exit 1)"
        fi
      fi
    fi

    kill "$LOADING_PID" 2>/dev/null
    wait "$LOADING_PID" 2>/dev/null

    log ""
    if [ "$KILLED" -eq 1 ]; then
      log " ✅ $app sent SIGKILL"
    else
      log " ⚠️ Could not kill $app"
    fi
    log "═══════════════════════════════════════════"

    echo -e "$LOG" | zenity --text-info \
        --title="Force Quit Result" \
        --width=500 --height=300 \
        --font="monospace"
  fi
}

LOCK_FILE="/tmp/plco-memory-assistant-alert.lock"

cleanup() {
  rm -f "$LOCK_FILE"
}
trap cleanup EXIT

# --- Main loop ---

while true; do
  usage=$(get_mem_usage)

  if [ "$usage" -ge "$THRESHOLD" ]; then
    if [ ! -f "$LOCK_FILE" ] || ! kill -0 "$(cat "$LOCK_FILE")" 2>/dev/null; then
      echo $$ > "$LOCK_FILE"
      canberra-gtk-play --id=dialog-warning &
      show_alert "$usage"
      rm -f "$LOCK_FILE"
    fi
  fi

  sleep 1
done